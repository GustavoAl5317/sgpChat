# Copie para .env dentro desta pasta.
#   cp .env.example .env

# Assina os tokens da interface web do GenieACS. Gere com:
#   openssl rand -hex 32
GENIEACS_JWT_SECRET=troque-por-um-valor-aleatorio

# Token que o SGP usa no caminho da URL da NBI. Sem ele o nginx devolve 404
# antes de tocar no GenieACS. Gere com:
#   cat /proc/sys/kernel/random/uuid
# Depois a URL a cadastrar no SGP fica:
#   https://SEU-HOST:7558/<este-token>
ACS_TOKEN=troque-por-um-uuid
