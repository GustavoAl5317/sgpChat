# HTTPS automatico via Let's Encrypt. Exige que {$DOMAIN} aponte para o IP
# deste servidor ANTES de subir o stack, senao a emissao do certificado falha.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Apenas a interface do n8n fica publica. Evolution API e Postgres
	# permanecem so na rede interna do Docker, sem porta exposta.
	reverse_proxy n8n:5678

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
